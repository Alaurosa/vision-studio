# ============================================
# Vision Studio — Root .env (server + Python local dev)
# ============================================
# Copy to .env at repo root for Express and FastAPI.
#
# Vercel (client): use client/.env.example only — VITE_API_URL + public Supabase.
# Do NOT set OPENAI_API_KEY, REPLICATE_API_TOKEN, or SERVICE_ROLE in Vite env.
#
# Render vision-studio-server: OPENAI_API_KEY, Supabase vars, PYTHON_SERVICE_URL, CORS.
# Render vision-studio-python: OPENAI_API_KEY; REPLICATE_API_TOKEN if using room-photo AI.
# ============================================

# Supabase (required for persisted data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_PUBLIC_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# OpenAI (server chat + Python floorplan parse)
OPENAI_API_KEY=sk-...

# Replicate (Python room-photo detection/segmentation only — optional if unused)
REPLICATE_API_TOKEN=r8_...

# Meshy (optional — offline 3D model generation)
MESHY_API_KEY=msy_...

# Server
PORT=3001
NODE_ENV=development
PYTHON_SERVICE_URL=http://localhost:5001

# CORS — Express API (credentials enabled; do not use "*")
# Production client (stable Vercel production URL)
CLIENT_ORIGIN=https://your-production-client.vercel.app
# Extra exact origins (comma-separated), e.g. named preview aliases
CLIENT_ORIGINS=https://preview1.vercel.app,https://preview2.vercel.app
# Legacy alias — merged with CLIENT_ORIGIN / CLIENT_ORIGINS
# ALLOWED_ORIGINS=https://another-client.example.com
# Allow any https origin whose host ends with .vercel.app (Vercel preview deployments)
ALLOW_VERCEL_PREVIEWS=true