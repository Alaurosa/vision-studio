# ============================================
# Vision Studio — All Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# All three services (client, server, python) read from this file.
#
# Get Supabase keys: Supabase Dashboard → Settings → API
# Get OpenAI key:    https://platform.openai.com/api-keys
# Get Replicate key: https://replicate.com/account/api-tokens
# ============================================

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required — powers the chat assistant)
OPENAI_API_KEY=sk-...

# Replicate (required — powers SAM 3 + Grounding DINO)
REPLICATE_API_TOKEN=r8_...

# Meshy (optional — offline 3D model generation)
MESHY_API_KEY=msy_...
