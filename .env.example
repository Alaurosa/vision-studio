# ============================================
# Vision Studio — All Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# All three services (client, server, python) read from this file.
#
# Get Supabase keys: Supabase Dashboard → Settings → API
# Get OpenAI key:    https://platform.openai.com/api-keys
# Get Replicate key: https://replicate.com/account/api-tokens
# ============================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...
SUPABASE_PUBLIC_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# OpenAI (required — powers the chat assistant)
OPENAI_API_KEY=sk-...

# Replicate (required — powers SAM 3 + Grounding DINO)
REPLICATE_API_TOKEN=r8_...

# Meshy (optional — offline 3D model generation)
MESHY_API_KEY=msy_...

# Server
PORT=3001
NODE_ENV=development
PYTHON_SERVICE_URL=http://localhost:5001

# CORS — Express API (credentials enabled; do not use "*")
# Production client (stable Vercel production URL)
CLIENT_ORIGIN=https://your-production-client.vercel.app
# Extra exact origins (comma-separated), e.g. named preview aliases
CLIENT_ORIGINS=https://preview1.vercel.app,https://preview2.vercel.app
# Legacy alias — merged with CLIENT_ORIGIN / CLIENT_ORIGINS
# ALLOWED_ORIGINS=https://another-client.example.com
# Allow any https origin whose host ends with .vercel.app (Vercel preview deployments)
ALLOW_VERCEL_PREVIEWS=true