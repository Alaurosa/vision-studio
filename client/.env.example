# Vision Studio — Vite client (copy to client/.env.local)
# Public vars only — never put OPENAI_API_KEY or REPLICATE_API_TOKEN here.

VITE_API_URL=http://localhost:3001

# Supabase (use NEXT_PUBLIC_* or VITE_* aliases)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
